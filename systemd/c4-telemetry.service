[Unit]
Description=Сбор телеметрии Citroen C4 через Lexia 3
Documentation=file:///home/jaennil/life/citroen/c4-can/CLAUDE.md
# Вместе со сбором поднимается живая досылка в кластер (см. sync-live.sh).
Wants=c4-sync-live.service c4-sync-local.service
# Запускается правилом udev при подключении Lexia (70-psa-diag.rules).
# Завершается сам, когда устройства нет 90 секунд - см. --exit-after-idle.

[Service]
Type=simple
User=jaennil
Group=jaennil
WorkingDirectory=/home/jaennil/life/citroen/c4-can
ExecStart=/home/jaennil/life/citroen/c4-can/.venv/bin/python \
    /home/jaennil/life/citroen/c4-can/drive.py --exit-after-idle 90 --ecu-every 20
# Вынул Lexia и воткнул обратно - служба поднимется снова по udev;
# упала по любой другой причине - перезапустится сама.
Restart=on-failure
RestartSec=5
# Досылка по событию. Раньше ExecStopPost тут уже стоял и был убран: вне дома SSH
# уходил в таймаут, три попытки - и остановка службы висела больше минуты. С тех
# пор sync-now.sh начинает с одной 5-секундной проверки достижимости и вне дома
# выходит сразу, так что стоп-хук снова безопасен.
# Смысл: как только сбор закончился (Lexia выдернута, 90 с тишины,
# остановка службы), остаток буфера уезжает в кластер, не дожидаясь таймера.
# При работающем живом режиме sync-now.sh уступает ему и выходит сразу.
ExecStopPost=/home/jaennil/life/citroen/c4-can/sync-now.sh
# Раньше 20 с: досылка хвоста 30-минутной поездки занимает около минуты.
TimeoutStopSec=150
Nice=5

[Install]
WantedBy=multi-user.target
