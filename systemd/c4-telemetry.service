[Unit]
Description=Сбор телеметрии Citroen C4 через Lexia 3
Documentation=file:///home/jaennil/life/citroen/c4-can/CLAUDE.md
# Запускается правилом udev при подключении Lexia (70-psa-diag.rules).
# Завершается сам, когда устройства нет 90 секунд - см. --exit-after-idle.

[Service]
Type=simple
User=jaennil
Group=jaennil
WorkingDirectory=/home/jaennil/life/citroen/c4-can
ExecStart=/home/jaennil/life/citroen/c4-can/.venv/bin/python \
    /home/jaennil/life/citroen/c4-can/drive.py --exit-after-idle 90 --ecu-every 60 \
    --ecus 6A8,6AD,6A8,747,6A8,742,6A8,75F,6A8,744,6A8,75D,6A8,730,6A8,6B5,6A8,765,6A8,77B
# Вынул Lexia и воткнул обратно - служба поднимется снова по udev;
# упала по любой другой причине - перезапустится сама.
Restart=on-failure
RestartSec=5
# Досылку тут НЕ запускаем. Раньше стоял ExecStopPost=sync-now.sh, и остановка
# службы висела больше минуты: вне домашней сети SSH уходит в таймаут, скрипт
# делает три попытки, а systemd всё это время ждёт в stop-post. Досылка и так
# идёт по таймеру c4-sync.timer каждые 15 минут, так что здесь она лишняя.
TimeoutStopSec=20
Nice=5

[Install]
WantedBy=multi-user.target
